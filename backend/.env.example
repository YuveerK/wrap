DATABASE_URL=postgresql://user:password@localhost:5434/wrap_db?schema=public
PORT=3000

JWT_ACCESS_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# Public URL of this API — used in verification & password-reset emails.
# Must be reachable from your phone's browser (NOT localhost when testing on a real device).
# Use your PC's LAN IP from `expo start` (e.g. exp://192.168.0.106:8081 → http://192.168.0.106:3000)
BACKEND_URL=http://192.168.0.106:3000
# Comma-separated origins for the mobile app / Expo dev server.
CORS_ORIGIN=http://localhost:8081,http://192.168.0.106:8081
APP_NAME="Wrap Community"
LOG_LEVEL=info

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RESIDENT
  COMMITTEE
  ADMIN
}

enum IssueCategory {
  POTHOLE
  ELECTRICITY
  WATER
  ROADS
  WASTE
  OTHER
}

enum PostCategory {
  NOTICES
  SAFETY
  EVENTS
  LOST_AND_FOUND
  RECOMMENDATIONS
}

enum IssueStatus {
  REPORTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  phone         String    @unique
  password      String
  firstName     String
  lastName      String
  streetAddress String
  postalCode    String
  profilePhoto  String?
  role          Role      @default(RESIDENT)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)

  verifyToken       String?
  verifyTokenExpiry DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?

  refreshTokens  RefreshToken[]
  pushTokens     PushToken[]
  issuesReported Issue[]        @relation("IssueReporter")
  issueUpdates   IssueUpdate[]
  issueSupports  IssueSupport[]
  issueWatches   IssueWatch[]
  posts          Post[]
  postLikes      PostLike[]
  postComments   PostComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Issue {
  id         Int           @id @default(autoincrement())
  reporterId Int
  reporter   User          @relation("IssueReporter", fields: [reporterId], references: [id])

  category    IssueCategory
  title       String
  description String
  status      IssueStatus   @default(REPORTED)

  addressText  String?
  latitude     Float?
  longitude    Float?
  supportCount Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates  IssueUpdate[]
  supports IssueSupport[]
  watches  IssueWatch[]

  @@index([status])
  @@index([createdAt])
}

model IssueUpdate {
  id       Int         @id @default(autoincrement())
  issueId  Int
  issue    Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId Int
  author   User        @relation(fields: [authorId], references: [id])

  status IssueStatus?
  note   String?

  createdAt DateTime @default(now())

  @@index([issueId, createdAt])
}

model IssueSupport {
  issueId   Int
  issue     Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    Int
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([issueId, userId])
}

model IssueWatch {
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([issueId, userId])
  @@index([issueId])
}

model Post {
  id       Int  @id @default(autoincrement())
  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  category     PostCategory @default(NOTICES)
  title        String?
  body         String
  pinned       Boolean      @default(false)
  bannerPath   String?
  likeCount    Int          @default(0)
  commentCount Int          @default(0)

  addressText String?
  latitude    Float?
  longitude   Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes       PostLike[]
  attachments PostAttachment[]
  comments    PostComment[]

  @@index([createdAt])
  @@index([category])
}

model PostLike {
  postId    Int
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model PostAttachment {
  id           Int      @id @default(autoincrement())
  postId       Int
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  originalName String?
  storedName   String
  mimeType     String
  sizeBytes    Int
  urlPath      String
  createdAt    DateTime @default(now())

  @@index([postId])
}

model PostComment {
  id       Int      @id @default(autoincrement())
  postId   Int
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId Int
  author   User     @relation(fields: [authorId], references: [id])
  parentId Int?
  parent   PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PostComment[] @relation("CommentReplies")
  body     String
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
  @@index([parentId])
}

model PushToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
